<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  For a future Mac App Store build (not used yet).
  The App Sandbox is switched on, and deliberately there is NO
  com.apple.security.network.client entitlement, so macOS itself
  blocks Cloakroom from making any internet connection.
  Files are reachable only when you pick them in an Open or Save dialog.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
